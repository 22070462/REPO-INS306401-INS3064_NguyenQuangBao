<?php
function calculateBMI(float $kg, float $m): string {
    $bmi = $kg / ($m * $m);
    $bmi = round($bmi, 1);
    if ($bmi < 18.5) {
        $category = "Under";
    } elseif ($bmi >= 18.5 && $bmi <= 24.9) {
        $category = "Normal";
    } else {
        $category = "Over";
    }
    return "BMI: $bmi ($category)";
}
echo calculateBMI(70, 1.78);  // Example call for output "BMI: 22.1 (Normal)"
?>
