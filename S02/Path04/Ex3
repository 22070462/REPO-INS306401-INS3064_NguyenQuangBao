<?php
function isPrime(int $n): bool {
    if ($n <= 1) {
        return false;
    }
    for ($i = 2; $i <= sqrt($n); $i++) {
        if ($n % $i == 0) {
            return false;
        }
    }
    return true;
}

for ($i = 2; $i <= 100; $i++) {
    if (isPrime($i)) {
        echo $i . ", ";
    }
}
?>
