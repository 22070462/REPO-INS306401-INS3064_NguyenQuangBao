<?php
$scores = [60, 88, 65, 91, 76];  // Example array; avg ~76, but adjust to match example if needed

$sum = array_sum($scores);
$count = count($scores);
$avg = $sum / $count;
$max = max($scores);
$min = min($scores);

$top = [];
foreach ($scores as $score) {
    if ($score > $avg) {
        $top[] = $score;
    }
}
sort($top);

echo "Avg: " . round($avg) . ", Top: [" . implode(", ", $top) . "]";
?>
